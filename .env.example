# Copy to .env and fill in. .env is gitignored.

# --- LLM (Gemini free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001

# --- Neo4j (matches docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testsigma123

# --- GitHub (optional: raises API rate limits for diff/PR fetch) ---
# A classic token with public_repo scope is plenty; unauthenticated also works but is rate-limited.
GITHUB_TOKEN=
